{
  "rewrites": [
    { "source": "/e/:slug", "destination": "/api/og?slug=:slug" },
    { "source": "/e/:slug/app", "destination": "/api/og?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/e/" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
